@model Bulky.Models.Movie

<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Create Movie</h2>
            <hr />
        </div>

        @* Title Field *@
        <div class="mb-3 row p-1">
            <label asp-for="Title" class="p-0"></label>
            <input asp-for="Title" class="form-control" placeholder="e.g. The Matrix" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        @* Genre Field *@
        <div class="mb-3 row p-1">
            <label asp-for="Genre" class="p-0"></label>
            <input asp-for="Genre" class="form-control" placeholder="e.g. Sci-Fi" />
            <span asp-validation-for="Genre" class="text-danger"></span>
        </div>

        @* Description Field *@
        <div class="mb-3 row p-1">
            <label asp-for="Description" class="p-0"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        @* --- AI SCRIPT SECTION --- *@
        <div class="mb-3 row p-1">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label asp-for="MovieScript" class="p-0 mb-0">Movie Script</label>

                @* The Button that opens the AI input *@
                <button type="button" class="btn btn-outline-warning btn-sm" onclick="toggleAiInput()">
                    ✨ Generate with AI
                </button>
            </div>

            @* Hidden "Prompt" Section *@
            <div id="ai-input-section" class="card bg-light mb-2 p-3" style="display:none;">
                <label class="form-label text-muted small"><strong>AI Instructions:</strong> What should happen in this movie?</label>
                <div class="input-group">
                    <input type="text" id="aiPrompt" class="form-control" placeholder="e.g. Write a tense scene where the hero defuses a bomb..." />
                    <button type="button" id="btnGenerateActual" class="btn btn-dark" onclick="generateScript()">Generate</button>
                </div>
                <small class="text-muted">A team of AI agents (Story Architect, Screenwriter, Script Doctor and Editor, powered by Llama 3) will outline, write, review and polish your scene.</small>
            </div>

            @* The actual Script Textarea (User can edit the result) *@
            <textarea asp-for="MovieScript" class="form-control" rows="10" placeholder="Script will appear here..."></textarea>
            <small id="aiGenreCheck" class="mt-1 p-0"></small>
            <span asp-validation-for="MovieScript" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-primary form-control">Create</button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Movie" asp-action="Index" class="btn btn-outline-secondary border form-control">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // 1. Toggle the hidden AI box
        function toggleAiInput() {
            var section = document.getElementById("ai-input-section");
            section.style.display = (section.style.display === "none") ? "block" : "none";
        }

        // 2. The function that calls the AI
        async function generateScript() {
            // Get values from the form
            var prompt = document.getElementById("aiPrompt").value;
            var title = document.getElementById("Title").value; // Matches asp-for="Title"
            var genre = document.getElementById("Genre").value; // Matches asp-for="Genre"
            var description = document.getElementById("Description").value; // Matches asp-for="Description"
            var genreCheckEl = document.getElementById("aiGenreCheck");

            // Get UI elements to show loading state
            var btn = document.getElementById("btnGenerateActual");
            var textArea = document.getElementById("MovieScript"); // Matches asp-for="MovieScript"

            // Validation
            if (!prompt) {
                alert("Please enter a plot summary or instruction for the AI.");
                return;
            }

            // UI: Switch to Loading State
            var originalText = btn.innerText;
            btn.disabled = true;
            btn.innerText = "Agents at work...";
            textArea.placeholder = "The agents are outlining, drafting and reviewing your scene... this can take a minute.";
            genreCheckEl.textContent = "";

            try {
                // Send data to the server
                const response = await fetch('/Movie/GenerateAiScript', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        prompt: prompt,
                        title: title,
                        genre: genre,
                        description: description
                    })
                });

                if (!response.ok) throw new Error('Network response was not ok');

                const data = await response.json();

                if (data.success) {
                    // Success! Typewriter effect (optional) or just paste it
                    textArea.value = data.script;
                    showGenreCheck(genreCheckEl, data.genreCheck, data.revisions);
                } else {
                    alert("Error: " + data.message);
                }

            } catch (error) {
                console.error('Error:', error);
                alert("Failed to generate script. Check console for details.");
            } finally {
                // UI: Reset Button
                btn.disabled = false;
                btn.innerText = originalText;
            }
        }

        // 3. Show the PyTorch genre classifier's verdict on the final script
        function showGenreCheck(el, check, revisions) {
            if (!check) {
                el.textContent = "";
                return;
            }
            var text = "Genre classifier: reads as " + check.predicted + " (" + Math.round(check.confidence * 100) + "% confidence)";
            if (check.matches === true) text += ", matches the requested genre";
            if (check.matches === false) text += ", does not match the requested genre";
            if (revisions > 0) text += " · revised " + revisions + "x for genre";

            el.textContent = text;
            el.className = "mt-1 p-0 " + (check.matches === false ? "text-warning" : "text-success");
        }
    </script>
}